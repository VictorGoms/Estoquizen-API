# ── Server ──────────────────────────────
PORT=3001
NODE_ENV=development

# ── Supabase ─────────────────────────────
# Encontre em: Supabase Dashboard → Settings → API
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=sua_anon_key_aqui           # chave pública (safe para expor)
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui   # chave privada — NUNCA expor no frontend/mobile

# ── CORS ─────────────────────────────────
# Origens permitidas separadas por vírgula
ALLOWED_ORIGINS=http://localhost:3000

# ── SMTP (Gmail) ─────────────────────────
# Use o mesmo email/app-password configurado no Supabase
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@gmail.com
SMTP_PASS=sua_app_password_aqui

# ── Resend (emails transacionais) ────────
# Cadastro gratuito em resend.com — plano free envia 3.000 emails/mês
RESEND_API_KEY=re_...

# ── Cron Job (cleanup de workspaces) ─────
# Segredo compartilhado entre Railway Cron e esta API
# Gere com: openssl rand -hex 32
CRON_SECRET=segredo_aleatorio_aqui

# ── Stripe ───────────────────────────────
# Chaves em: Stripe Dashboard → Desenvolvedores → Chaves de API
STRIPE_SECRET_KEY=sk_test_...
# Obtido rodando: stripe listen --forward-to localhost:3001/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs em: Stripe Dashboard → Catálogo de produtos → (produto) → Preços
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_PRO=price_...
# Configuração do portal SEM troca de plano, usada em POST /billing/portal (EQZ-57).
# Stripe → Configurações → Portal do cliente (uma por modo: teste e real)
STRIPE_PORTAL_CONFIG_GERAL=bpc_...
