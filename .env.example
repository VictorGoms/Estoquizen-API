# ── Server ──────────────────────────────
PORT=3001
NODE_ENV=development

# ── Supabase ─────────────────────────────
# Encontre em: Supabase Dashboard → Settings → API
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=sua_anon_key_aqui           # chave pública (safe para expor)
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui   # chave privada — NUNCA expor no frontend/mobile

# ── CORS ─────────────────────────────────
# Origens permitidas separadas por vírgula
ALLOWED_ORIGINS=http://localhost:3000

# ── SMTP (Gmail) ─────────────────────────
# Use o mesmo email/app-password configurado no Supabase
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@gmail.com
SMTP_PASS=sua_app_password_aqui
